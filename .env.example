# ==========================================
# SANITY.IO CMS CONFIGURATION
# ==========================================

# ID do projeto Sanity (obtido em https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID="seu_project_id_aqui"

# Dataset do Sanity (padrão: production)
NEXT_PUBLIC_SANITY_DATASET="production"

# Versão da API do Sanity
NEXT_PUBLIC_SANITY_API_VERSION="2026-10-15"

# Chave secreta compartilhada para o Webhook de revalidação sob demanda (/api/revalidate)
# Crie qualquer string segura (ex: openssl rand -hex 32)
SANITY_REVALIDATE_SECRET="sua_chave_secreta_revalidacao_aqui"

# Token com permissão de escrita (Editor) para rodar o script de migração: npm run migrate:sanity
# Crie em: sanity.io/manage > [Projeto] > API > Tokens > Add API Token (Editor)
SANITY_API_WRITE_TOKEN="seu_token_de_escrita_aqui"